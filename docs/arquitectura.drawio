d="c10" value="detectorAnomalias (tope 1)&lt;br&gt;EWMA + z-score propio y&lt;br&gt;por pares, causa común" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="72" height="72" as="geometry"/></mxCell><mxCell id="c11" value="iaExplicar (tope 1)&lt;br&gt;causa y texto por rol&lt;br&gt;Gemini o plantilla" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="72" height="72" as="geometry"/></mxCell><mxCell id="c12" value="Amazon Rekognition&lt;br&gt;detect-labels sobre la&lt;br&gt;foto del componente" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rekognition;" vertex="1" parent="1"><mxGeometry x="1200" y="190" width="72" height="72" as="geometry"/></mxCell><mxCell id="c13" value="analizarFoto (tope 1)&lt;br&gt;guarda la foto en S3&lt;br&gt;y pide etiquetas" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1420" y="190" width="72" height="72" as="geometry"/></mxCell><mxCell id="c14" value="SSM Parameter Store&lt;br&gt;SecureString: claves de&lt;br&gt;Gemini y GCP, ARN, umbrales" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.parameter_store;" vertex="1" parent="1"><mxGeometry x="100" y="420" width="72" height="72" as="geometry"/></mxCell><mxCell id="c15" value="AWS KMS&lt;br&gt;cifra los SecureString" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="72" height="72" as="geometry"/></mxCell><mxCell id="c16" value="CloudWatch&lt;br&gt;logs JSON y métricas&lt;br&gt;de concurrencia" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="100" y="640" width="72" height="72" as="geometry"/></mxCell><mxCell id="c17" value="Menos de 10 Lambdas a la vez&lt;br&gt;- tope (reservedConcurrency) en cada función&lt;br&gt;- ingesta y carga histórica sin Lambdas&lt;br&gt;- sin Parallel de Lambdas en Step Functions&lt;br&gt;- frontend: 1 consulta a /panel cada 15 s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F3FBF;fontStyle=0;fillColor=#F4F7FF;strokeColor=#1F3FBF;rounded=1;" vertex="1" parent="1"><mxGeometry x="250" y="600" width="215" height="150" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#E7157B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="380" width="620" height="380" as="geometry"/></mxCell><mxCell id="c19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="510" y="400" width="72" height="72" as="geometry"/></mxCell><mxCell id="c20" value="Step Functions: FlujoIncidente" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#B0105B;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="395" width="380" height="30" as="geometry"/></mxCell><mxCell id="c21" value="1. Leer incidente (DynamoDB directo, sin Lambda)&lt;br&gt;2. Choice por severidad: define el SLA&lt;br&gt;3. Explicar con IA: iaExplicar&lt;br&gt;4. Asignar técnico: cercanía, especialidad, ETA&lt;br&gt;5. Reservar repuesto: almacén más cercano&lt;br&gt;6. Preparar avisos: 4 bandejas en 1 Lambda&lt;br&gt;7. Parallel: sns:publish directo a 3 roles&lt;br&gt;8. Wait SLA y luego: ¿lo atendieron?&lt;br&gt;9. Si no: escalar a supervisor y luego gerente&lt;br&gt;Catch: aviso por SNS si algo falla" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#232F3E;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="510" y="440" width="580" height="310" as="geometry"/></mxCell><mxCell id="c22" value="operaciones (tope 1)&lt;br&gt;asignar, reservar,&lt;br&gt;notificar, escalar" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1200" y="420" width="72" height="72" as="geometry"/></mxCell><mxCell id="c23" value="SNS: 3 tópicos&lt;br&gt;uno por rol" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="72" height="72" as="geometry"/></mxCell><mxCell id="c24" value="API Gateway REST&lt;br&gt;una sola API&lt;br&gt;(CORS solo web)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="1420" y="420" width="72" height="72" as="geometry"/></mxCell><mxCell id="c25" value="Lambdas de consulta&lt;br&gt;/panel, /flota, cerrar" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1420" y="640" width="72" height="72" as="geometry"/></mxCell><mxCell id="c26" value="EventBridge&lt;br&gt;regla diaria&lt;br&gt;(06:00 Lima)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="100" y="860" width="72" height="72" as="geometry"/></mxCell><mxCell id="c27" value="Step Functions&lt;br&gt;PreventivoDiario" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="320" y="860" width="72" height="72" as="geometry"/></mxCell><mxCell id="c28" value="batchFlota (tope 1)&lt;br